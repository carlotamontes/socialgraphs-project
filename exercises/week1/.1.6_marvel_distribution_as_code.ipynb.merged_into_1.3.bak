     ]
    }
   ],
   "source": [
    "id_to_name = dict(zip(nodes.node_id, nodes.name))\n",
    "\n",
    "top5_in = sorted(in_degree.items(), key=lambda kv: kv[1], reverse=True)[:5]\n",
    "top5_out = sorted(out_degree.items(), key=lambda kv: kv[1], reverse=True)[:5]\n",
    "\n",
    "print(\"Top 5 by in-degree (most-linked-to — 'famous'):\")\n",
    "for node_id, k in top5_in:\n",
    "    print(f\"  {id_to_name[node_id]:<32} in-degree = {k}\")\n",
    "\n",
    "print(\"\\nTop 5 by out-degree (links out the most — 'a list'):\")\n",
    "for node_id, k in top5_out:\n",
    "    print(f\"  {id_to_name[node_id]:<32} out-degree = {k}\")\n",
    "\n",
    "assert top5_in[0] == (\"Spider-Man\", 106), \"Spider-Man should top in-degree at 106 per the course page\"\n",
    "assert top5_out[0] == (\"Betsy_Braddock\", 28), \"Betsy Braddock should top out-degree at 28 per the course page\"\n",
    "print(\"\\nMatches the course page exactly: Spider-Man in-degree=106, Betsy Braddock out-degree=28. ✓\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d65232eb",
   "metadata": {},
   "source": [
    "Only the in-degree tail stretches out into power-law-looking territory (all the way to Spider-Man at 106); the out-degree tail dies out almost four times earlier, at Betsy Braddock's 28. That is because in-links are *conferred* — some other article's editors decide independently that this character is worth mentioning, so nothing stops that count from growing without bound as more and more pages point at the same famous hub. Out-links are *authored* — one person has to sit down and write each one into a single article, so an out-degree is capped by how much any one page's editors were willing to write. In this network, in-degree is closer to \"how famous is this character across the whole encyclopedia\", while out-degree is closer to \"how thorough is this one article.\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "86b71d55",
   "metadata": {},
   "source": [
    "## Part 3 — Binning\n",
    "\n",
    "Implement the exact scheme from the course page's Goodies note: working in $u = k+1$, width-1 bins for $u = 1, \\dots, 7$, then doubling bins $[8,16), [16,32), [32,64), [64,128)$. Each bin's count is divided by the bin's *width* (so what's plotted is a probability density, not a raw count), and each bin is drawn at the **geometric mean** of the integers it actually covers — not the arithmetic midpoint."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "5817feaf",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-03T14:51:52.674153Z",
     "iopub.status.busy": "2026-09-03T14:51:52.673860Z",
     "iopub.status.idle": "2026-09-03T14:51:53.818991Z",
     "shell.execute_reply": "2026-09-03T14:51:53.817252Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1100x450 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def bin_edges(u_max):\n",
    "    \"\"\"width-1 bins for u=1..7, then doubling bins, as far as u_max requires.\"\"\"\n",
    "    edges = [(u, u + 1) for u in range(1, 8)]  # [1,2), [2,3), ..., [7,8)\n",
    "    lo = 8\n",
    "    while lo <= u_max:\n",
    "        edges.append((lo, lo * 2))\n",
    "        lo *= 2\n",
    "    return edges\n",
    "\n",
    "def binned_distribution(degree_dict, n):\n",
    "    u_values = np.array([k + 1 for k in degree_dict.values()])\n",
    "    u_max = int(u_values.max())\n",
    "    counts = np.bincount(u_values, minlength=u_max + 1)\n",
    "    xs, ys = [], []\n",
    "    for lo, hi in bin_edges(u_max):\n",
    "        hi_clipped = min(hi, u_max + 1)          # don't reach past the data\n",
    "        integers_in_bin = np.arange(lo, hi_clipped)\n",
    "        if len(integers_in_bin) == 0:\n",
    "            continue\n",
    "        count_in_bin = counts[lo:hi_clipped].sum()\n",
    "        width = hi - lo                            # nominal bin width, e.g. 8 for [8,16)\n",
    "        density = (count_in_bin / n) / width\n",
    "        gmean = np.sqrt(integers_in_bin.min() * integers_in_bin.max())\n",
    "        xs.append(gmean)\n",
    "        ys.append(density)\n",
    "    return np.array(xs), np.array(ys)\n",
    "\n",
    "u_in_binned, P_in_binned = binned_distribution(in_degree, n)\n",
    "u_out_binned, P_out_binned = binned_distribution(out_degree, n)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4.5))\n",
    "\n",
    "axes[0].scatter(u_in, P_in, s=15, color=\"tab:red\", alpha=0.5, label=\"raw\")\n",
    "axes[0].plot(u_in_binned, P_in_binned, \"o-\", color=\"darkred\", label=\"binned\")\n",
    "axes[0].set_xscale(\"log\"); axes[0].set_yscale(\"log\")\n",
    "axes[0].set_title(\"In-degree: raw vs. binned\")\n",
    "axes[0].set_xlabel(\"in-degree + 1 (log)\"); axes[0].set_ylabel(\"P(k) (log)\")\n",
    "axes[0].legend()\n",
    "\n",
    "axes[1].scatter(u_out, P_out, s=15, color=\"tab:blue\", alpha=0.5, label=\"raw\")\n",
    "axes[1].plot(u_out_binned, P_out_binned, \"o-\", color=\"darkblue\", label=\"binned\")\n",
    "axes[1].set_xscale(\"log\"); axes[1].set_yscale(\"log\")\n",
    "axes[1].set_title(\"Out-degree: raw vs. binned\")\n",
    "axes[1].set_xlabel(\"out-degree + 1 (log)\"); axes[1].set_ylabel(\"P(k) (log)\")\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "e051c2f7",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-03T14:51:53.822980Z",
     "iopub.status.busy": "2026-09-03T14:51:53.822557Z",
     "iopub.status.idle": "2026-09-03T14:51:53.832318Z",
     "shell.execute_reply": "2026-09-03T14:51:53.830519Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "All width-1 bins (u=1..7) match the raw in-degree distribution exactly. ✓\n",
      "\n",
      "Binned in-degree points (x = geometric mean, y = density):\n",
      "  x=   1.00   P=0.191419\n",
      "  x=   2.00   P=0.135314\n",
      "  x=   3.00   P=0.141914\n",
      "  x=   4.00   P=0.092409\n",
      "  x=   5.00   P=0.069307\n",
      "  x=   6.00   P=0.072607\n",
      "  x=   7.00   P=0.042904\n",
      "  x=  10.95   P=0.018977\n",
      "  x=  22.27   P=0.005363\n",
      "  x=  44.90   P=0.000309\n",
      "  x=  82.75   P=0.000103\n"
     ]
    }
   ],
   "source": [
    "# The width-1 bins (u = 1..7) must coincide EXACTLY with the raw points -- nothing to average\n",
    "# where every value already has its own bin.\n",
    "for u in range(1, 8):\n",
    "    if u in u_in:\n",
    "        raw_val = P_in[u_in == u][0]\n",
    "        bin_val = P_in_binned[np.isclose(u_in_binned, u)][0]\n",
    "        assert np.isclose(raw_val, bin_val), f\"u={u}: raw {raw_val} != binned {bin_val}\"\n",
    "\n",
    "print(\"All width-1 bins (u=1..7) match the raw in-degree distribution exactly. ✓\")\n",
    "print(\"\\nBinned in-degree points (x = geometric mean, y = density):\")\n",
    "for x, y in zip(u_in_binned, P_in_binned):\n",
    "    print(f\"  x={x:7.2f}   P={y:.6f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f0bf9560",
   "metadata": {},
   "source": [
    "Notice the last doubling bin for in-degree, $[64,128)$: only Spider-Man's article ($u=107$) lives up there, so that whole bin holds a single character, and its density is tiny simply because it's being divided by a nominal width of 64 — a reminder that a binned dot far in the tail rests on very little data, even though it looks like a solid point on the plot."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "52d8e87f",
   "metadata": {},
   "source": [
    "## Part 4 — Two mathematical specimens vs. the real thing\n",
    "\n",
    "Reproduce the *two-distributions* explorable: 10,000 samples from an exponential distribution and 10,000 from a power law, on all four linear/log axis combinations — then lay the real in-degree distribution over the same log–log axes and see which specimen it resembles."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "0310cd05",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-03T14:51:53.836353Z",
     "iopub.status.busy": "2026-09-03T14:51:53.835830Z",
     "iopub.status.idle": "2026-09-03T14:51:55.402893Z",
     "shell.execute_reply": "2026-09-03T14:51:55.401114Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1100x800 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Only the log-log panel makes the power law fall on a straight line;\n",
      "the exponential never straightens on log-log -- it curves away in the tail.\n"
     ]
    }
   ],
   "source": [
    "# Power law via inverse-transform sampling: p(x) ∝ x^-alpha for x >= x_min.\n",
    "alpha, x_min = 2.5, 1.0\n",
    "U = RNG.random(10_000)\n",
    "power_samples = x_min * (1 - U) ** (-1 / (alpha - 1))\n",
    "\n",
    "# Exponential, shifted by +1 to sit on the same u = k+1 footing as the real data (keeps x >= 1).\n",
    "exp_samples = RNG.exponential(scale=5.0, size=10_000) + 1\n",
    "\n",
    "def hist_density(samples, bins):\n",
    "    counts, edges = np.histogram(samples, bins=bins)\n",
    "    widths = np.diff(edges)\n",
    "    centers = np.sqrt(edges[:-1] * edges[1:])   # geometric-mean bin centers, log-axis-appropriate\n",
    "    density = counts / counts.sum() / widths\n",
    "    mask = counts > 0\n",
    "    return centers[mask], density[mask]\n",
    "\n",
    "log_bins = np.logspace(0, np.log10(max(power_samples.max(), exp_samples.max())), 40)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(11, 8))\n",
    "specs = [\n",
    "    (False, False, \"linear-linear\"), (True, False, \"log-linear\"),\n",
    "    (False, True, \"linear-log\"), (True, True, \"log-log\"),\n",
    "]\n",
    "for ax, (xlog, ylog, title) in zip(axes.flat, specs):\n",
    "    lin_bins = np.linspace(0, max(power_samples.max(), exp_samples.max()), 60)\n",
    "    bins = log_bins if xlog else lin_bins\n",
    "    xp, yp = hist_density(power_samples, bins)\n",
    "    xe, ye = hist_density(exp_samples, bins)\n",
    "    ax.plot(xp, yp, \"o\", ms=3, color=\"tab:purple\", label=\"power law\")\n",
    "    ax.plot(xe, ye, \"o\", ms=3, color=\"tab:green\", label=\"exponential\")\n",
    "    if xlog: ax.set_xscale(\"log\")\n",
    "    if ylog: ax.set_yscale(\"log\")\n",
    "    ax.set_title(title)\n",
    "    ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(\"Only the log-log panel makes the power law fall on a straight line;\")\n",
    "print(\"the exponential never straightens on log-log -- it curves away in the tail.\")"
   ]
  },
